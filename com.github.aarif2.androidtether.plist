<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.aarif2.androidtether</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/androidtetherd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/androidtether.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/androidtether.log</string>
</dict>
</plist>
